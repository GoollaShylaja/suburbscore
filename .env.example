# ─────────────────────────────────────────────
# Root .env — read by Docker Compose
# Copy to .env and fill in your own values
# ─────────────────────────────────────────────

# Postgres superuser (Docker uses this to initialise the container)
POSTGRES_USER=your_admin_username
POSTGRES_PASSWORD=your_admin_password

# user-service — owns suburbscore_users database
USER_DB_USERNAME=your_user_service_db_username
USER_DB_PASSWORD=your_user_service_db_password

# suburb-service — owns suburbscore_suburbs database
SUBURB_DB_USERNAME=your_suburb_service_db_username
SUBURB_DB_PASSWORD=your_suburb_service_db_password
