# ─────────────────────────────────────────────
# user-service environment variables
# Copy this file to .env and fill in real values
# Database: suburbscore_users (port 5433 locally)
# ─────────────────────────────────────────────

# PostgreSQL credentials
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT — generate a secure random string (min 32 chars / 256 bits)
# Must be IDENTICAL across all services (user-service, suburb-service, etc.)
# Example: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
JWT_EXPIRATION_MS=86400000

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Swagger UI — set true during development only, false in production
SWAGGER_ENABLED=false
